# Copiá este archivo a .env y completá los valores. NO subas .env al repositorio.

# Secreto para firmar las sesiones (mínimo 32 caracteres). Generá uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Opcionales
PORT=3000
# CORS_ORIGIN=http://localhost:3000
# NODE_ENV=production

# Cuentas de prueba que crea `npm run seed` (elegí tus propias contraseñas)
SEED_ADMIN_USER=admin@ejemplo.com
SEED_ADMIN_PASSWORD=
SEED_USER_USER=usuario@ejemplo.com
SEED_USER_PASSWORD=
